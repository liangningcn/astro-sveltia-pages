{
    "name": "astro-sveltia-pages",
    "version": "0.2.6",
    "description": "Generates /admin (index.html + config.yml) for Sveltia CMS, with Cloudflare R2 media support and a GitHub OAuth template for Cloudflare Pages and EdgeOne Pages.",
    "keywords": [
        "astro-integration",
        "astro-loader",
        "sveltiacms",
        "withastro",
        "cloudflare-pages",
        "edgeone-pages",
        "oauth"
    ],
    "homepage": "https://github.com/liangningcn/astro-sveltia-pages#readme",
    "bugs": {
        "url": "https://github.com/liangningcn/astro-sveltia-pages/issues"
    },
    "license": "MIT",
    "author": "liangningcn (based on original work by Johannes Knoll)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liangningcn/astro-sveltia-pages.git"
    },
    "directories": {
        "example": "example"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "bin": {
        "astro-sveltia-pages": "./dist/cli.mjs"
    },
    "exports": {
        ".": "./dist/index.mjs",
        "./loader": "./dist/loader.mjs",
        "./functions": "./dist/functions/index.mjs",
        "./functions/cloudflare": "./dist/functions/cloudflare.mjs",
        "./functions/edgeone": "./dist/functions/edgeone.mjs",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vp run build:templates && vp pack",
        "build:templates": "node scripts/build-templates.mjs",
        "check:templates": "node scripts/build-templates.mjs && git diff --exit-code -- templates/",
        "dev": "vp pack --watch",
        "test": "vp test",
        "check": "vp check",
        "format": "vp fmt .",
        "format:check": "vp fmt --check .",
        "prepublishOnly": "vp run build",
        "prepare": "vp config"
    },
    "dependencies": {
        "@sveltia/cms": "^0.248.1",
        "js-yaml": "^4.1.0",
        "zod-to-ts": "^2.0.0"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^25.6.2",
        "@typescript/native-preview": "7.0.0-dev.20260509.2",
        "astro": "^7.3.8",
        "bumpp": "^11.1.0",
        "typescript": "^6.0.3",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "^4.1.1"
    },
    "peerDependencies": {
        "astro": "^7.0.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.10.0",
            "onFail": "download"
        }
    }
}

{
    "name": "astro-sveltia-pages",
    "version": "0.2.3",
    "description": "Zero-config Sveltia CMS integration for Astro with built-in OAuth, optimized for Cloudflare Pages.",
    "keywords": [
        "astro-integration",
        "astro-loader",
        "sveltiacms",
        "withastro",
        "cloudflare-pages",
        "oauth"
    ],
    "homepage": "https://github.com/liangningcn/astro-sveltia-pages#readme",
    "bugs": {
        "url": "https://github.com/liangningcn/astro-sveltia-pages/issues"
    },
    "license": "MIT",
    "author": "liangningcn (based on original work by Johannes Knoll)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liangningcn/astro-sveltia-pages.git"
    },
    "directories": {
        "example": "example"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": "./dist/index.mjs",
        "./loader": "./dist/loader.mjs",
        "./routes/auth": "./dist/routes/auth.mjs",
        "./routes/callback": "./dist/routes/callback.mjs",
        "./package.json": "./package.json",
        "./admin.astro": "./dist/admin.astro"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "test": "vp test",
        "check": "vp check",
        "format": "vp fmt .",
        "format:check": "vp fmt --check .",
        "prepublishOnly": "vp run build",
        "prepare": "vp config"
    },
    "dependencies": {
        "@sveltia/cms": "^0.248.1",
        "zod-to-ts": "^2.0.0"
    },
    "devDependencies": {
        "@types/node": "^25.6.2",
        "@typescript/native-preview": "7.0.0-dev.20260509.2",
        "astro": "^7.3.8",
        "bumpp": "^11.1.0",
        "typescript": "^6.0.3",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "^4.1.1"
    },
    "peerDependencies": {
        "astro": "^7.0.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.10.0",
            "onFail": "download"
        }
    }
}
